<UserControl x:Class="TDU2_Track_Records.powerlap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel>
            <GroupBox Header="Island" Width="110">
                <ComboBox x:Name="IslandSelector" AutomationProperties.Name="Island"/>
            </GroupBox>
            <GroupBox Header="Track" Width="280">
                <ComboBox x:Name="TrackSelector" DisplayMemberPath="Name" SelectedValuePath="id"
                          ToolTip="Tracks with saved lap times" AutomationProperties.Name="Track"/>
            </GroupBox>
            <GroupBox Header="Class" Width="158">
                <ComboBox x:Name="ClassSelector" AutomationProperties.Name="Class">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding ImagePath}" Width="20" Height="20"/>
                                <TextBlock Text="{Binding Description}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </GroupBox>
            <GroupBox Header="Weather" Width="105">
                <ComboBox x:Name="WeatherSelector" AutomationProperties.Name="Weather"/>
            </GroupBox>
            <GroupBox x:Name="DirectionFilter" Header="Direction" Width="130" Visibility="Collapsed">
                <ComboBox x:Name="DirectionSelector" AutomationProperties.Name="Direction"/>
            </GroupBox>
            <Button x:Name="ShowLapsButton" Content="Show Laps" IsEnabled="False" Margin="6,0,0,9"
                    VerticalAlignment="Bottom" Style="{DynamicResource AppPrimaryButtonStyle}"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button x:Name="ScreenshotButton" IsEnabled="False" Margin="6,0,0,9" VerticalAlignment="Bottom"
                        Padding="10,10" Style="{DynamicResource AppScopedButtonStyle}"
                        AutomationProperties.Name="Take a screenshot">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M1,5 H5 L7,2 H13 L15,5 H19 V16 H1 Z M13,10 A3,3 0 1 1 7,10 A3,3 0 1 1 13,10"
                              Stroke="{DynamicResource HudTextBrush}" StrokeThickness="1.5" Width="20" Height="18"
                              Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Take a screenshot" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CopyScreenshotButton" IsEnabled="False" Margin="6,0,0,9" VerticalAlignment="Bottom"
                        Padding="10,10" Style="{DynamicResource AppScopedButtonStyle}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M5,4 H2 V18 H14 V4 H11 M5,2 H11 V6 H5 Z"
                              Stroke="{DynamicResource HudTextBrush}" StrokeThickness="1.5" Width="18" Height="18"
                              Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Copy to clipboard" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </WrapPanel>

        <Grid Grid.Row="1" Margin="2,8,2,2">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Top">
                    <ContentControl x:Name="BoardHost" Visibility="Collapsed"
                                    AutomationProperties.Name="Power Laps results"/>
                </Viewbox>
            </ScrollViewer>
            <TextBlock x:Name="PowerLapStatus" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="{DynamicResource AppMutedForegroundBrush}" TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</UserControl>
