<UserControl x:Class="TDU2_Track_Records.PowerLapBoard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="1010" MinHeight="671" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="146"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border>
            <Border.Background>
                <ImageBrush ImageSource="/Images/powerLapbg.png" Stretch="UniformToFill"
                            ViewboxUnits="Absolute" Viewbox="0,0,900,130"/>
            </Border.Background>
        </Border>
        <Border Grid.Row="1" Padding="28,4,28,28">
            <Border.Background>
                <ImageBrush ImageSource="/Images/powerLapbg.png" Stretch="UniformToFill"
                            ViewboxUnits="Absolute" Viewbox="0,130,900,1450"
                            ViewportUnits="Absolute" Viewport="0,0,1010,1627.22" TileMode="FlipY"/>
            </Border.Background>
            <StackPanel>
                <WrapPanel HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock x:Name="TrackTitle" FontFamily="Britannic Bold, Segoe UI"
                               FontSize="32" FontWeight="Bold" Foreground="#FFB90000" MaxWidth="780"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Image x:Name="RestrictionIcon" Width="38" Height="38" VerticalAlignment="Center"/>
                    <Border x:Name="RestrictionBadge" Background="#DFEEEEEE" Padding="7,3"
                            VerticalAlignment="Center" CornerRadius="2">
                        <TextBlock x:Name="RestrictionText" Foreground="#FF191919" FontFamily="Segoe UI"
                                   FontWeight="SemiBold" FontSize="16"/>
                    </Border>
                    <Image x:Name="ConditionsIcon" Width="28" Height="28" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <Image x:Name="DirectionIcon" Width="28" Height="28" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </WrapPanel>
                <ItemsControl x:Name="RecordRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border HorizontalAlignment="Center" Background="#DDEDEDED" Margin="0,0,0,4" Padding="30,1">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"
                                           FontFamily="Bradley Hand ITC, Segoe Print" FontSize="26"
                                           FontWeight="Bold" Foreground="Black"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
