<Window x:Class="TDU2_Track_Records.houses"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:p="clr-namespace:TDU2_Track_Records.Properties"
        xmlns:local="clr-namespace:TDU2_Track_Records"
        mc:Ignorable="d" FontFamily="Adobe Gothic Std B"
        FontSize="20"
        MinWidth="1100"
        MinHeight="500"
        Title="Houses"
        WindowStyle="None"
        AllowsTransparency="True" 
        Opacity="{Binding Source={x:Static p:Settings.Default}, Path=MainWindowOpacity, Mode=OneWay}"
        Background="{x:Null}"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        HorizontalContentAlignment="Stretch"
        ScrollViewer.HorizontalScrollBarVisibility="Auto"
        MouseLeftButtonDown="dealerships_MouseLeftButtonDown">
    <Border BorderBrush="{DynamicResource AppShellBorderBrush}" BorderThickness="{DynamicResource AppShellBorderThickness}"
            CornerRadius="{DynamicResource AppShellCornerRadius}"
            Margin="0"
            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            >
        <Grid ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Image x:Name="Settings_Button" MouseLeftButtonDown="Settings_MouseLeftButtonDown"
                   Margin="0,0,5,0" MinWidth="32" MinHeight="32"
                   ToolTip="Settings" Width="50" Height="50">
                    <Image.Style>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Source" Value="Images/ico/navigation/settings.png"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Source" Value="Images/ico/navigation/settings_over.png"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <Image x:Name="Minimize_Button" MouseLeftButtonDown="Minimize_MouseLeftButtonDown"
                   Margin="0,0,5,0" MinWidth="32" MinHeight="32"
                   ToolTip="Minimize Application" Width="50" Height="50">
                    <Image.Style>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Source" Value="Images/ico/navigation/minimize.png"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Source" Value="Images/ico/navigation/minimize_over.png"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
                <Image x:Name="Close_Button" MouseLeftButtonDown="Close_Button_MouseLeftButtonDown"
                   Margin="0,0,5,0" MinWidth="32" MinHeight="32"
                   ToolTip="Close Application" Width="50" Height="50">
                    <Image.Style>
                        <Style TargetType="{x:Type Image}">
                            <Setter Property="Source" Value="Images/ico/navigation/close.png"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Source" Value="Images/ico/navigation/close_over.png"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </StackPanel>

            <!-- Stitch-inspired title, island, and search toolbar. -->
            <Grid x:Name="IslandSelector" Grid.Column="1" Grid.Row="1" Margin="0,0,10,6" Background="#F21A1C20">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="14,8" VerticalAlignment="Center">
                    <Border Width="5" Background="#FFE52521" Margin="0,0,10,0"/>
                    <TextBlock Text="HOUSES &amp; GARAGES" Foreground="#FFF2F2F4" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Margin="12,0,0,0" Padding="8,3" Background="#FF0C0E12" BorderBrush="#FF3B3E45" BorderThickness="1">
                        <TextBlock x:Name="LocationCountText" Text="PROPERTIES" Foreground="#FFFFB4AA" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8" VerticalAlignment="Center">
                    <Menu x:Name="LocationMenus" IsMainMenu="False" Background="Transparent"
                          FontSize="13" VerticalAlignment="Center"/>
                    <StackPanel Margin="6,0,0,0">
                        <TextBlock Text="HOUSE SEARCH" Foreground="#FFAAAEB7" FontSize="10"/>
                        <TextBox x:Name="LocationSearchBox" Width="150" Height="34" Padding="10,4"
                                 FontSize="14" VerticalContentAlignment="Center"
                                 ToolTip="Filter owned properties"
                                 AutomationProperties.Name="Filter owned properties"/>
                    </StackPanel>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="VEHICLE / BRAND SEARCH" Foreground="#FFAAAEB7" FontSize="10"/>
                        <TextBox x:Name="VehicleSearchBox" Width="190" Height="34" Padding="10,4"
                                 FontSize="14" VerticalContentAlignment="Center"
                                 TextChanged="VehicleSearchBox_TextChanged"
                                 ToolTip="Find cars across owned garages by name, brand, or model"
                                 AutomationProperties.Name="Find cars across owned garages"/>
                    </StackPanel>
                </StackPanel>
            </Grid>


            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                        Margin="0,0,0,6" VerticalAlignment="Top" HorizontalAlignment="Center">
                <GroupBox x:Name="HouseName" Visibility="Collapsed" HorizontalAlignment="Stretch">
                    <GroupBox.Header>
                        <TextBlock x:Name="HouseNameText" MaxWidth="500" TextWrapping="Wrap"
                                   TextAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="HouseImage" Width="245" Height="138" Stretch="Uniform" Margin="5,2,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="5,0,0,0">
                            <GroupBox Header="Rating" VerticalAlignment="Top">
                                <TextBlock x:Name="HouseRating" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </GroupBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <GroupBox Header="Price" HorizontalContentAlignment="Center" Padding="5,0,5,0" VerticalAlignment="Top">
                                <TextBlock x:Name="HousePrice" FontWeight="Bold" HorizontalAlignment="Center" MinWidth="82"/>
                            </GroupBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <GroupBox Header="Owned" VerticalAlignment="Top">
                                <TextBlock x:Name="HouseOwned" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </GroupBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                            <GroupBox Header="Max Slots" VerticalAlignment="Top">
                                <TextBlock x:Name="HouseMaxSlots" FontWeight="Bold" HorizontalAlignment="Center"/>
                            </GroupBox>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
            <!-- Houses Display -->
            <ScrollViewer x:Name="VehiclesScrollViewer" Grid.Column="1" Grid.Row="3" Grid.ColumnSpan="2"
              Margin="0,4,0,0" Visibility="Collapsed"
                      MouseLeftButtonDown="dealerships_MouseLeftButtonDown"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      FocusVisualStyle="{x:Null}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      ClipToBounds="True"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch">
                <Grid x:Name="VehiclesStackPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                </Grid>
            </ScrollViewer>

            <Border x:Name="GarageSearchResultsPanel" Grid.Column="1" Grid.Row="2" Grid.RowSpan="2" Grid.ColumnSpan="2"
                    Visibility="Collapsed" Margin="0,0,0,0" Background="#F21A1C20"
                    BorderBrush="#FF3B3E45" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="14,10,14,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="5" Background="#FFE52521" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="GarageSearchHeading" Text="GARAGE SEARCH RESULTS"
                                       Foreground="#FFF2F2F4" FontSize="19" FontWeight="Bold"/>
                            <TextBlock Text="Results from every owned garage; select either island menu to return to a house."
                                       Foreground="#FFAAAEB7" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <DataGrid x:Name="GarageSearchTable" Margin="12,0,12,12"
                                  Style="{StaticResource VehicleSearchTableStyle}"
                                  CellStyle="{StaticResource VehicleSearchCellStyle}"
                                  RowStyle="{StaticResource VehicleSearchRowStyle}"
                                  ColumnHeaderStyle="{StaticResource VehicleSearchColumnHeaderStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="44" ElementStyle="{StaticResource VehicleSearchTextStyle}"/>
                                <DataGridTemplateColumn Header="IMAGE" Width="112" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding}" Click="GarageThumbnail_Click" Padding="0" Margin="0"
                                                    Background="#FF0C0E12" BorderBrush="#FFE52521" BorderThickness="1"
                                                    ToolTip="Click to enlarge; click outside the image to close">
                                                <Image Source="{Binding Thumbnail}" Width="92" Height="56" Stretch="Uniform"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="BRAND" Binding="{Binding Brand}" Width="135" ElementStyle="{StaticResource VehicleSearchTextStyle}"/>
                                <DataGridTextColumn Header="CAR NAME" Binding="{Binding CarName}" Width="2*" MinWidth="160" ElementStyle="{StaticResource VehicleSearchTextStyle}"/>
                                <DataGridTemplateColumn Header="CLASS" Width="70" SortMemberPath="VehicleClass"
                                                        CellTemplate="{StaticResource VehicleClassCellTemplate}"/>
                                <DataGridTemplateColumn Header="UPGRADE STAGE" Width="125" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" ToolTip="{Binding UpgradeSummary}">
                                                <Image Source="{Binding UpgradeImage}" Width="48" Height="48" Stretch="Uniform"/>
                                                <TextBlock Text="{Binding UpgradeSummary}" Foreground="#FFFFB4AA" FontSize="11"
                                                           VerticalAlignment="Center" Margin="5,0,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="TOP SPEED" Binding="{Binding TopSpeed}" Width="95" ElementStyle="{StaticResource VehicleSearchTextStyle}"/>
                                <DataGridTextColumn Header="ACCELERATION" Binding="{Binding Acceleration}" Width="110" ElementStyle="{StaticResource VehicleSearchTextStyle}"/>
                                <DataGridTextColumn Header="HORSEPOWER" Binding="{Binding Horsepower}" Width="100" ElementStyle="{StaticResource VehicleSearchTextStyle}"/>
                                <DataGridTextColumn Header="GARAGE" Binding="{Binding Garage}" Width="2*" MinWidth="148" ElementStyle="{StaticResource VehicleSearchTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="GarageSearchEmptyText" Text="NO MATCHING CARS IN THE ACTIVE PROFILE"
                                   Visibility="Collapsed" Foreground="#FFAAAEB7" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid x:Name="ImagePreviewOverlay" Grid.Column="1" Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="2"
                  Visibility="Collapsed" Panel.ZIndex="100" Background="#DD000000"
                  MouseLeftButtonDown="ImagePreviewOverlay_MouseLeftButtonDown">
                <Border Background="#FF121418" BorderBrush="#FFE52521" BorderThickness="2" Padding="10"
                        HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="850" MaxHeight="610"
                        MouseLeftButtonDown="ExpandedVehicleBorder_MouseLeftButtonDown">
                    <StackPanel>
                        <TextBlock x:Name="ExpandedVehicleCaption" Foreground="#FFF2F2F4" FontSize="18"
                                   FontWeight="Bold" HorizontalAlignment="Center" Margin="4,0,4,8"/>
                        <Image x:Name="ExpandedVehicleImage" Stretch="Uniform" MaxWidth="820" MaxHeight="550"/>
                        <TextBlock Text="Click outside the image to close" Foreground="#FFAAAEB7" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
