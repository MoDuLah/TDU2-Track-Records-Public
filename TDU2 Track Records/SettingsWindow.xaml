<Window x:Class="TDU2_Track_Records.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:TDU2_Track_Records.Properties"
        xmlns:local="clr-namespace:TDU2_Track_Records"
        Title="Settings" Width="980" Height="500" MinWidth="620" MinHeight="380"
        MouseLeftButtonDown="Window_MouseLeftButtonDown" Closing="Window_Closing"
        Opacity="{Binding Source={x:Static p:Settings.Default}, Path=MainWindowOpacity}"
        FontFamily="{DynamicResource AppMainFontFamily}" FontSize="16"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Window.Resources>
        <local:UnitConverter x:Key="UnitConverter"/>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Header="Save Profile" Style="{DynamicResource AppLabeledGroupBoxStyle}" VerticalAlignment="Top">
                <StackPanel Margin="5">
                    <TextBlock Text="The active profile syncs automatically." Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <DockPanel>
                        <Button x:Name="SyncSelectedProfileButton" Content="Sync Selected Profile"
                                Click="SyncSelectedProfile_Click" DockPanel.Dock="Right"
                                Margin="8,0,0,0" Padding="8,2"
                                ToolTip="Import cars, garage locations, slots, and mileage for the selected profile"/>
                        <ComboBox x:Name="ProfileComboBox"
                                  SelectionChanged="ProfileComboBox_SelectionChanged"
                                  ToolTip="Choose the active Track Records save profile"/>
                    </DockPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <Label Content="Check every (seconds)" Target="{Binding ElementName=SaveCheckIntervalComboBox}"
                               Padding="0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SaveCheckIntervalComboBox" Width="82" Margin="8,0,0,0"
                                  AutomationProperties.Name="Save check interval in seconds"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Units" Grid.Column="2" Style="{DynamicResource AppLabeledGroupBoxStyle}" VerticalAlignment="Top">
                <StackPanel Margin="5">
                    <DockPanel LastChildFill="False" HorizontalAlignment="Center">
                        <TextBlock Text="Metric" VerticalAlignment="Center"/>
                        <Slider x:Name="UnitSlider" Minimum="0" Maximum="1" TickFrequency="1"
                                IsSnapToTickEnabled="True" Width="110" Margin="8,0"
                                Value="{Binding Source={x:Static p:Settings.Default}, Path=system, Converter={StaticResource UnitConverter}, Mode=OneWay}"
                                ToolTip="Switch between Metric and Imperial immediately"/>
                        <TextBlock Text="Imperial" VerticalAlignment="Center"/>
                    </DockPanel>
                    <WrapPanel HorizontalAlignment="Center" Margin="0,6,0,0">
                        <TextBlock Text="{Binding Source={x:Static p:Settings.Default}, Path=speed}" Margin="4,0"/>
                        <TextBlock Text="{Binding Source={x:Static p:Settings.Default}, Path=weight}" Margin="4,0"/>
                        <TextBlock Text="{Binding Source={x:Static p:Settings.Default}, Path=distance}" Margin="4,0"/>
                        <TextBlock Text="{Binding Source={x:Static p:Settings.Default}, Path=torque}" Margin="4,0"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Dealership Columns" Grid.Row="1" Style="{DynamicResource AppLabeledGroupBoxStyle}" VerticalAlignment="Top">
                <TextBox Text="{Binding Source={x:Static p:Settings.Default}, Path=dealershipColumns, Mode=TwoWay}"
                         HorizontalContentAlignment="Center" Margin="5"/>
            </GroupBox>

            <GroupBox Header="Opacity" Grid.Row="1" Grid.Column="2" Style="{DynamicResource AppLabeledGroupBoxStyle}" VerticalAlignment="Top">
                <StackPanel Margin="5">
                    <TextBlock Text="Main window"/>
                    <DockPanel Margin="0,3,0,8">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:P0}}"
                                   Width="45" Margin="8,0,0,0" TextAlignment="Right" VerticalAlignment="Center"/>
                        <Slider x:Name="OpacitySlider" Minimum="0.05" LargeChange="0.25" Maximum="1"
                                TickFrequency="0.05" TickPlacement="Both" AutomationProperties.Name="Main window opacity"
                                Value="{Binding Source={x:Static p:Settings.Default}, Path=MainWindowOpacity, Mode=TwoWay}"/>
                    </DockPanel>
                    <TextBlock Text="Carbon background"/>
                    <DockPanel Margin="0,3,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ElementName=BGOpacitySlider, Path=Value, StringFormat={}{0:P0}}"
                                   Width="45" Margin="8,0,0,0" TextAlignment="Right" VerticalAlignment="Center"/>
                        <Slider x:Name="BGOpacitySlider" Minimum="0" LargeChange="0.25" Maximum="1"
                                TickFrequency="0.05" TickPlacement="Both" AutomationProperties.Name="Carbon background opacity"
                                Value="{Binding Source={x:Static p:Settings.Default}, Path=BGOpacity, Mode=TwoWay}"/>
                    </DockPanel>
                </StackPanel>
            </GroupBox>
        </Grid>
    </ScrollViewer>
</Window>
